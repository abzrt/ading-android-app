<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:clipChildren="false">

    <!-- Subtle Decorative Top-Left Accent Circle -->
    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_marginTop="-90dp"
        android:layout_marginStart="-90dp"
        android:background="@drawable/bg_corner_top_left" />

    <!-- Subtle Decorative Bottom-Right Accent Circle -->
    <View
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="-100dp"
        android:layout_marginEnd="-100dp"
        android:background="@drawable/bg_corner_bottom_right" />

    <!-- Center Hero Content: Uploaded Mascot Artwork, Brand Title & Badge, Subtitle -->
    <LinearLayout
        android:id="@+id/splashHeroContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="28dp"
        android:paddingRight="28dp"
        android:paddingBottom="36dp">

        <ImageView
            android:id="@+id/ivSplashMascot"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:src="@drawable/splash_mascot"
            android:scaleType="fitCenter"
            android:contentDescription="@string/app_name"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/splashTextContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/splash_brand_title"
                android:textColor="@color/primary"
                android:textSize="34sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_splash_badge"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/splash_brand_badge"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.28" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/splash_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Content: Gradient Progress Bar, Organization Branding & Release Build Number -->
    <LinearLayout
        android:id="@+id/splashFooterContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginBottom="28dp"
        android:paddingLeft="32dp"
        android:paddingRight="32dp">

        <ProgressBar
            android:id="@+id/splashProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="160dp"
            android:layout_height="5dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/bg_splash_progress"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_footer"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvSplashVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:letterSpacing="0.03" />

    </LinearLayout>

</RelativeLayout>
