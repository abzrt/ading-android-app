{
  "manifest_version": 3,
  "name": "ADING Web Auto-Dispatch WFM FLOW",
  "version": "1.2.1",
  "description": "Otomatis salin data ADING, ambil SS kartu Workorder HD dari WFM FLOW Standalone Railway, unmask nama/alamat, dan kirim ke Channel Telegram Teknisi.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://ading.web.id/*",
    "https://bot-production-a5484be7.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ADING Auto-Dispatch WFM FLOW",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://ading.web.id/*"],
      "js": ["ading_page_hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://ading.web.id/*"],
      "js": ["ading_content.js"],
      "run_at": "document_idle"
    }
  ]
}
